# Environment variables for local development
# Copy this file to `.env` and fill in the values. Never commit real secrets.

# Public Supabase client settings (used by the frontend)
# Set these in your local `.env` file (do not commit real secrets).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key for server-side scripts (seeding, admin tasks). Keep this secret.
# Use SUPABASE_SERVICE_KEY when running `npm run seed`.
SUPABASE_SERVICE_KEY=

# Node environment
NODE_ENV=development
